{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "declarationDir": "dist/types",

    // El tsconfig base hereda jsx del proyecto; lo fijamos en react-jsx
    // para que tsc emita declaraciones correctamente desde .tsx.
    "jsx": "react-jsx",

    // Resuelve el path alias `@/*` si lo usás en algún archivo
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    "skipLibCheck": true,
    "incremental": false
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    ".next/types/**/*",
    ".next/dev/types/**/*"
  ]
}